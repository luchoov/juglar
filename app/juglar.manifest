<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded into juglar.exe by build.rs. Declaring Windows 10 and 11
     support lets the window be a layered child window, which wallpaper mode
     needs on Windows 11 24H2 and later; without a manifest, Windows treats
     a program as written for Vista and refuses that. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
